# ========================================================
# Hirose Maintenance Log - Frontend Environment Configuration
# ========================================================
# Salin berkas ini menjadi .env di dalam folder frontend:
# cp .env.example .env

# --- Application Branding & Identity ---
VITE_APP_NAME="Hirose Maintenance Log"
VITE_APP_TITLE="Hirose Maintenance Log - PT Hirose Electric Indonesia"

# --- Backend API Endpoint Connection ---
# URL server backend Hono yang melayani endpoint /api/*
VITE_API_BASE_URL=http://localhost:3000
